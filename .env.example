VITE_API_URL=http://localhost:2026/

VITE_RELEASE_NAME=Venga! 🧗🏼‍♂️
VITE_VERSION=
VITE_GIT_HASH=
VITE_COPYRIGHT=© 2026 W4H Toolkit contributors. Licensed under the MIT License.

VITE_DATE_FORMAT=YYYY-MM-DD
VITE_DATETIME_FORMAT=MM-DD-YYYY hh:mm:ss A

# Optional (local dev only): prefill admin setup + Sign in in the SPA.
# Leave blank or set locally; never commit secrets.
# Escape literal $ as \$ (Vite expands $VAR in .env values).
# Docs / Playwright accounts live in w4h-docs (dev/docs-fixtures.md), not here.
VITE_APP_ADMIN_EMAIL=
VITE_APP_ADMIN_PASSWORD=
